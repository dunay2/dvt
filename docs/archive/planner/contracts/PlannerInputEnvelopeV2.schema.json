{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvt:planner:PlannerInputEnvelopeV2:v2.3.1",
  "type": "object",
  "required": ["nodes", "selection"],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "resourceType", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "nodeId": { "type": "string" },
          "resourceType": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["selectedNodeIds"],
      "additionalProperties": false,
      "properties": {
        "selectedNodeIds": { "type": "array", "items": { "type": "string" } },
        "includeUpstream": { "type": "boolean" },
        "includeDownstream": { "type": "boolean" }
      }
    },
    "policies": { "$ref": "dvt:planner:PlannerPolicyClassSet:v2.3.1" },
    "observability": { "type": "object", "additionalProperties": true },
    "requestedBy": { "type": "string" },
    "requestId": { "type": "string" },
    "requestedAtIso": { "type": "string" }
  },
  "$defs": {
    "PlannerPolicyClassSet": {
      "$id": "dvt:planner:PlannerPolicyClassSet:v2.3.1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "at-most-once" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxAttempts"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "at-most-N" },
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20
                }
              }
            }
          ]
        },
        "timeout": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "unbounded" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxSeconds"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "budget" },
                "maxSeconds": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "concurrency": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "sequential" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxParallel"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "bounded" },
                "maxParallel": { "type": "integer", "minimum": 2 }
              }
            },
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "unbounded" }
              }
            }
          ]
        }
      }
    }
  }
}
