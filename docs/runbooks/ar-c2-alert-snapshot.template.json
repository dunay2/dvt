    },
    {
      "thresholdKey": "ar-c2.outbox-drain-lag.critical",
      "alertRuleId": "ar-c2-outbox-drain-lag-critical",
      "expression": "histogram_quantile(0.95, sum(rate(dvt_delivery_outbox_drain_lag_seconds_bucket[15m])) by (le)) > 60",
      "window": "15m",
      "severity": "critical",
      "routingTarget": "delivery-oncall-pager",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
      "reviewer": "oncall@example.com"
