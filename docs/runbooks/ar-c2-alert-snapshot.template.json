{
  "rules": [
    {
      "thresholdKey": "ar-c2.start-run-latency.warning",
      "alertRuleId": "ar-c2-start-run-latency-warning",
      "expression": "histogram_quantile(0.50, sum(rate(dvt_api_run_start_latency_seconds_bucket[15m])) by (le)) > 0.5",
      "window": "15m",
      "severity": "warning",
      "routingTarget": "api-oncall",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
      "reviewer": "oncall@example.com"
    },
    {
      "thresholdKey": "ar-c2.start-run-latency.critical",
      "alertRuleId": "ar-c2-start-run-latency-critical",
      "expression": "histogram_quantile(0.99, sum(rate(dvt_api_run_start_latency_seconds_bucket[15m])) by (le)) > 2.5",
      "window": "15m",
      "severity": "critical",
      "routingTarget": "api-oncall-pager",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
      "reviewer": "oncall@example.com"
    },
    {
      "thresholdKey": "ar-c2.plan-compile-latency.warning",
      "alertRuleId": "ar-c2-plan-compile-latency-warning",
      "expression": "histogram_quantile(0.50, sum(rate(dvt_api_plan_compile_latency_seconds_bucket[15m])) by (le)) > 1.2",
      "window": "15m",
      "severity": "warning",
      "routingTarget": "api-oncall",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
      "reviewer": "oncall@example.com"
    },
    {
      "thresholdKey": "ar-c2.plan-compile-latency.critical",
      "alertRuleId": "ar-c2-plan-compile-latency-critical",
      "expression": "histogram_quantile(0.99, sum(rate(dvt_api_plan_compile_latency_seconds_bucket[15m])) by (le)) > 6",
      "window": "15m",
      "severity": "critical",
      "routingTarget": "api-oncall-pager",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
      "reviewer": "oncall@example.com"
    },
    {
      "thresholdKey": "ar-c2.outbox-drain-lag.warning",
