      "alertRuleId": "ar-c2-run-status-stale-ratio-critical",
      "expression": "sum(rate(dvt_api_run_status_snapshot_staleness_result_total{result=\"stale\"}[15m])) / sum(rate(dvt_api_run_status_snapshot_staleness_result_total[15m])) > 0.2",
      "window": "15m",
      "severity": "critical",
      "routingTarget": "api-oncall-pager",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
      "reviewer": "oncall@example.com"
    },
    {
      "thresholdKey": "ar-c2.run-status-unknown-ratio.critical",
      "alertRuleId": "ar-c2-run-status-unknown-ratio-critical",
      "expression": "sum(rate(dvt_api_run_status_snapshot_staleness_result_total{result=\"unknown\"}[24h])) / sum(rate(dvt_api_run_status_snapshot_staleness_result_total[24h])) > 0.001",
      "window": "24h",
      "severity": "critical",
      "routingTarget": "api-oncall-pager",
      "configSource": "grafana://alerting/rule/<uid>?version=<version>",
      "capturedAt": "2026-05-15T00:00:00Z",
