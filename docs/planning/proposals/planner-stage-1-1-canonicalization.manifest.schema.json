{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dvt.local/planning/proposals/planner-stage-1-1-canonicalization.manifest.schema.json",
  "title": "Stage 1.1 Planner Canonicalization Manifest",
  "description": "Repository-validated structured companion artifact for the Stage 1.1 planner canonicalization proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifactId",
    "schemaVersion",
    "status",
    "lastReviewed",
    "humanProposalPath",
    "structuredArtifactPath",
    "legacyMarkdownCompanionPath",
    "legacyMarkdownCompanionStatus",
    "policyBoundary",
    "locationState",
    "sourceBasis",
    "sectionIndex",
    "diagramRefs",
    "decisionIndex",
    "illustrativeShapes",
    "gapRegister",
    "artifactMapping",
    "verificationDeliverables",
    "machineReaderGuidance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "artifactId": {
      "const": "planner.stage-1-1.canonicalization.manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed"]
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "humanProposalPath": {
      "$ref": "#/$defs/repoPath"
    },
    "structuredArtifactPath": {
      "$ref": "#/$defs/repoPath"
    },
    "legacyMarkdownCompanionPath": {
      "$ref": "#/$defs/repoPath"
    },
    "legacyMarkdownCompanionStatus": {
      "type": "string",
      "enum": ["replaced_by_manifest"]
    },
    "policyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanProposalIsPolicyAuthority",
        "divergenceRule",
        "structuredArtifactMayIntroduceNewSubstantiveDecisions",
        "structuredArtifactPurpose"
      ],
      "properties": {
        "humanProposalIsPolicyAuthority": {
          "const": true
        },
        "divergenceRule": {
          "type": "string",
          "enum": ["human_proposal_wins_until_synchronized"]
        },
        "structuredArtifactMayIntroduceNewSubstantiveDecisions": {
          "const": false
        },
        "structuredArtifactPurpose": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "locationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentPrimaryHumanArtifactPath",
        "currentStructuredArtifactPath",
        "targetPrimaryArtifactPaths"
      ],
      "properties": {
        "currentPrimaryHumanArtifactPath": {
          "$ref": "#/$defs/repoPath"
        },
        "currentStructuredArtifactPath": {
          "$ref": "#/$defs/repoPath"
        },
        "targetPrimaryArtifactPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        }
      }
    },
    "sourceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeGovernance", "designSources", "historicalContext"],
      "properties": {
        "activeGovernance": {
          "$ref": "#/$defs/pathArray"
        },
        "designSources": {
          "$ref": "#/$defs/pathArray"
        },
        "historicalContext": {
          "$ref": "#/$defs/pathArray"
        }
      }
    },
    "sectionIndex": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/sectionRef"
      }
    },
    "diagramRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/diagramRef"
      }
    },
    "decisionIndex": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/decisionRef"
      }
    },
    "illustrativeShapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/illustrativeShape"
      }
    },
    "gapRegister": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gapRef"
      }
    },
    "artifactMapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactMapping"
      }
    },
    "verificationDeliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/deliverable"
      }
    },
    "machineReaderGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryUses", "readHumanFor", "treatAsUnresolvedWhen"],
      "properties": {
        "primaryUses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "readHumanFor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "treatAsUnresolvedWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(docs|packages|tools|scripts|package\\.json).+"
    },
    "pathArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "sectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "humanSection"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "humanSection": {
          "type": "string",
          "pattern": "^\\d+$"
        }
      }
    },
    "diagramRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "humanSection", "diagramType"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DG-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "humanSection": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "diagramType": {
          "type": "string",
          "enum": [
            "mermaid-graph",
            "mermaid-classDiagram",
            "mermaid-sequenceDiagram"
          ]
        }
      }
    },
    "decisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "humanSectionRefs", "policyStatus"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "humanSectionRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "policyStatus": {
          "type": "string",
          "enum": [
            "selected",
            "selected_with_gap",
            "selected_target_state_pending",
            "proposed_plan"
          ]
        },
        "decisionClass": {
          "type": "string",
          "enum": [
            "canonical_ownership",
            "boundary_rule",
            "migration_rule",
            "documentation_policy",
            "gap_declaration"
          ]
        }
      }
    },
    "illustrativeShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "humanSectionRefs",
        "status",
        "ownerToCanonize"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^IS-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "humanSectionRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "status": {
          "type": "string",
          "enum": ["illustrative_until_canonized"]
        },
        "ownerToCanonize": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gapRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "currentState",
        "requiredArtifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G-\\d{2}\\.\\d+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "currentState": {
          "type": "string",
          "minLength": 1
        },
        "closedBy": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentArtifact", "problem", "targetOwner", "actions"],
      "properties": {
        "currentArtifact": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "targetOwner": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverable", "verifierRole", "expectedEvidenceTypes"],
      "properties": {
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "verifierRole": {
          "type": "string",
          "minLength": 1
        },
        "expectedEvidenceTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "accepted_note_path",
              "boundary_note_path",
              "canonical_doc_path",
              "canonical_planning_artifact_path",
              "ci_check_path",
              "compatibility_note_path",
              "contract_path",
              "diff_note",
              "engine_boundary_path",
              "execution_task_reference",
              "execution_tracker_path",
              "inventory_file_path",
              "issue_tracker_reference",
              "migration_note",
              "plan_item_reference",
              "pr_scoped_change_summary",
              "review_note_path",
              "schema_path",
              "script_path"
            ]
          }
        }
      }
    }
  }
}
