#!/bin/sh
# $3 == 1 means branch checkout (not file checkout).
if [ "$3" != "1" ]; then exit 0; fi

PREV=$1
CURR=$2

# Keep files introduced by branch switches normalized for local AI and editor loops.
if command -v pnpm >/dev/null 2>&1; then
  pnpm -s postgit:format -- --from "$PREV" --to "$CURR" --label post-checkout --hook || true
fi

CHANGED=$(git diff --name-only "$PREV" "$CURR" -- "docs/planning/state/agent-lane-*.yaml" 2>/dev/null || true)

if [ -n "$CHANGED" ]; then
  echo "[post-checkout] agent-lane YAML changed. Run: pnpm docs:workboard:generate"
fi
