#!/bin/sh
# Regenerate planning views when switching to a branch with different agent-lane YAMLs.
# $3 == 1 means branch checkout (not file checkout).
if [ "$3" != "1" ]; then exit 0; fi

PREV=$1
CURR=$2
CHANGED=$(git diff --name-only "$PREV" "$CURR" -- "docs/planning/state/agent-lane-*.yaml" 2>/dev/null || true)

if [ -n "$CHANGED" ]; then
  echo "[post-checkout] agent-lane YAML changed — regenerating workboard views..."
  pnpm -s docs:workboard:generate
fi
