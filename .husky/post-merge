#!/bin/sh
# Regenerate planning views when agent-lane YAMLs may have changed (after pull/merge).
CHANGED=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)

if echo "$CHANGED" | grep -q "docs/planning/state/agent-lane-.*\.yaml"; then
  echo "[post-merge] agent-lane YAML changed — regenerating workboard views..."
  pnpm -s docs:workboard:generate
fi
