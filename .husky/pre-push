#!/bin/sh
set -e

# Fast path by default to reduce local push friction.
# Use DVT_PREPUSH_STRICT=1 when you explicitly want the full gate locally.
if [ "$DVT_PREPUSH_STRICT" = "1" ]; then
  echo "Running strict pre-push verifications: pnpm verify:prepush -- --full --hook"
  pnpm -s verify:prepush -- --full --hook
else
  echo "Running fast pre-push verifications: pnpm verify:prepush -- --hook"
  pnpm -s verify:prepush -- --hook
fi
