{
  "name": "dvt-temporal-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node ../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"dvt-temporal-worker^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-temporal-worker^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-temporal-worker^...\" build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/adapter-temporal": "workspace:*",
    "@dvt/artifacts": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/temporal-dbt-plugin": "workspace:*",
    "@dvt/temporal-http-json-plugin": "workspace:*",
    "@dvt/temporal-object-file-postgres-plugin": "workspace:*",
    "@temporalio/activity": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "pino": "^10.3.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@dvt/crypto": "workspace:*",
    "@temporalio/testing": "1.23.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tar": "^7.5.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.4"
  }
}
