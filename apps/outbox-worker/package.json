{
  "name": "dvt-outbox-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node ../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"dvt-outbox-worker^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-outbox-worker^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-outbox-worker^...\" build",
    "test": "vitest run --config vitest.config.ts",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "@dvt/state-store": "workspace:*",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.11.10",
    "dependency-cruiser": "^17.3.9",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.4"
  }
}
