{
  "name": "dvt-outbox-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @dvt/adapter-postgres build && pnpm --filter @dvt/engine build",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/engine": "workspace:*",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
