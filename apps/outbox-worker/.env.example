NODE_ENV=development
LOG_LEVEL=info
DVT_OUTBOX_OWNERSHIP_MODE=active
DATABASE_URL=postgresql://dvt:dvt@localhost:5432/dvt
DVT_PG_SCHEMA=dvt
DVT_OUTBOX_SHARD_COUNT=1
DVT_OUTBOX_OWNED_SHARD_IDS=0
DVT_OUTBOX_WORKER_POLL_INTERVAL_MS=1000
DVT_OUTBOX_WORKER_BATCH_SIZE=100
DVT_OUTBOX_WORKER_ERROR_BACKOFF_MS=5000
DVT_OUTBOX_WORKER_STOP_ON_ERROR=false
DVT_OUTBOX_WORKER_RUN_MIGRATIONS=true
DVT_OUTBOX_EVENT_BUS_MODE=http
DVT_OUTBOX_HTTP_TARGET_URL=http://localhost:8080/outbox/events
DVT_OUTBOX_HTTP_TIMEOUT_MS=10000
DVT_OUTBOX_HTTP_BEARER_TOKEN=
DVT_PURGE_ENABLED=true
DVT_PURGE_INTERVAL_MS=3600000
DVT_PURGE_DELIVERED_OUTBOX_RETENTION_DAYS=7
DVT_PURGE_OUTBOX_DEAD_LETTER_RETENTION_DAYS=30
DVT_PURGE_LINEAGE_DEAD_LETTER_RETENTION_DAYS=30
DVT_PURGE_MAX_ROWS_PER_RUN=5000
DVT_RUN_EVENT_RETENTION_ENABLED=true
DVT_RUN_EVENT_RETENTION_ALLOW_FILESYSTEM_IN_PROD=false
DVT_RUN_EVENT_RETENTION_INITIAL_DELAY_MS=30000
DVT_RUN_EVENT_RETENTION_INTERVAL_MS=3600000
DVT_RUN_EVENT_RETENTION_HOT_RETENTION_DAYS=90
DVT_RUN_EVENT_RETENTION_TENANT_HOT_RETENTION_DAYS=
DVT_RUN_EVENT_RETENTION_ARCHIVE_BUCKET_COUNT=64
DVT_RUN_EVENT_RETENTION_PIN_TERMINAL_SNAPSHOTS=true
DVT_RUN_EVENT_RETENTION_ARCHIVE_DIRECTORY=.dvt/archive
DVT_OUTBOX_ADMIN_HOST=0.0.0.0
DVT_OUTBOX_ADMIN_PORT=9464
SERVICE_NAME=dvt-outbox-worker
