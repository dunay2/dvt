{
  "name": "dvt-lineage-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node ../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"dvt-lineage-worker^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-lineage-worker^...\" build",
    "pretypecheck": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-lineage-worker^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/traceability-service": "workspace:*",
    "pino": "^10.3.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.4"
  }
}
