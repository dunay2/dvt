{
  "name": "dvt-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter \"dvt-api^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm --filter \"dvt-api^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter \"dvt-api^...\" build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/adapter-temporal": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/observability-otel": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.2.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@dvt/planner": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.10",
    "dependency-cruiser": "^17.3.9",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
