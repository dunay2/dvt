{
  "name": "dvt-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "predev": "pnpm --filter \"dvt-api^...\" build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-api^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-api^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-api^...\" build",
    "test": "vitest run --config vitest.config.ts",
    "pretest:integration": "pnpm --filter \"dvt-api^...\" build && pnpm build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/adapter-temporal": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/observability-otel": "workspace:*",
    "@dvt/plan-verifier": "workspace:*",
    "@dvt/planner": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.2.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pg": "^8.11.10",
    "dependency-cruiser": "^17.3.9",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.4"
  }
}
