{
  "name": "dvt-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "predev": "pnpm --filter \"dvt-api^...\" build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node ../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"dvt-api^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-api^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.config.ts\" --max-warnings 0",
    "pretest": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"dvt-api^...\" build",
    "test": "vitest run --config vitest.config.ts",
    "test:ci": "pnpm test:unit && pnpm test:integration:ci",
    "test:full": "pnpm test:unit && pnpm test:integration:ci",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:integration": "pnpm --filter \"dvt-api^...\" build && pnpm build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts",
    "proof:start-run-otel": "vitest run --config vitest.integration.config.ts test/integration/startRunOpenTelemetry.integration.test.ts"
  },
  "dependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/adapter-temporal": "workspace:*",
    "@dvt/artifacts": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/crypto": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/observability-otel": "workspace:*",
    "@dvt/plan-verifier": "workspace:*",
    "@dvt/planner": "workspace:*",
    "@dvt/run-domain": "workspace:*",
    "@dvt/temporal-dbt-plugin": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.2.0",
    "js-yaml": "^5.4.1",
    "libpg-query": "16.7.3",
    "pg": "^8.12.0",
    "pgsql-deparser": "16.1.1",
    "pino": "^10.3.1",
    "yaml": "^2.8.2",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.4"
  }
}
