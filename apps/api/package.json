{
  "name": "dvt-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @dvt/observability build && pnpm --filter @dvt/observability-otel build && pnpm --filter @dvt/adapter-postgres build && pnpm --filter @dvt/engine build",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/observability-otel": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/sensible": "^6.0.0",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/pg": "^8.11.10"
  }
}
