{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "..\\..",
    "paths": {
      "@dvt/adapter-postgres": [
        "packages/@dvt/adapter-postgres/dist/index.d.ts"
      ],
      "@dvt/contracts": ["packages/@dvt/contracts/dist/index.d.ts"],
      "@dvt/engine": ["packages/@dvt/engine/dist/index.d.ts"],
      "@dvt/observability": ["packages/@dvt/observability/dist/index.d.ts"],
      "@dvt/observability-otel": [
        "packages/@dvt/observability-otel/dist/index.d.ts"
      ]
    },
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.tsx", "src/**/*.jsx"]
}
