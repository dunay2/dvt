NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*
DATABASE_URL=postgresql://dvt:dvt@localhost:5432/dvt
SERVICE_NAME=dbf-api

# LOCAL foundation only: configuration/preflight does not enable LOCAL Preview.
# Keep disabled until the native lifecycle and remaining #3389 gates are complete.
DVT_LOCAL_DATA_ENABLED=false
# Enabling requires all values below. Budgets are per instance, not per session.
# Pre-provision both absolute, symlink-free roots outside each other.
# LOCAL root must be service-owned with POSIX mode 0700 and trusted ancestors.
# Native Windows ACL validation is not implemented: enabled preflight rejects it.
# No root creation, chmod repair, database replacement or cleanup at startup.
# DVT_LOCAL_DATA_ROOT=/var/lib/dvt-local
# DVT_WORKSPACE_FILES_ROOT=/var/lib/dvt-workspaces
# DVT_DUCKDB_MEMORY_LIMIT_BYTES=134217728
# DVT_DUCKDB_THREADS=1
# DVT_DUCKDB_MAX_TEMP_BYTES=268435456
# DVT_LOCAL_DATA_MAX_OPEN_WORKSPACES=2
# DVT_LOCAL_DATA_MAX_CONCURRENT_SESSIONS=2
