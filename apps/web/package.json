{
  "name": "@dvt/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "pretest": "pnpm run test:deps",
    "test:deps": "node ../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/web^...\" build",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "dev": "vite",
    "preview:e2e": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test:e2e": "pnpm build:e2e && start-server-and-test preview:e2e http://127.0.0.1:4173 \"node ./scripts/run-cypress-docker.mjs\"",
    "test:e2e:first-authoring:live": "node ../../scripts/run-canvas-first-authoring-live-proof.cjs",
    "test:e2e:source-import:live": "node ../../scripts/run-canvas-source-import-live-proof.cjs",
    "test:e2e:selected-closure:live": "node ../../scripts/run-selected-closure-live-proof.cjs",
    "test:e2e:dbt-author-code-run:live": "node ../../scripts/run-selected-closure-live-proof.cjs --spec apps/web/cypress/e2e/canvas/canvas-dbt-author-code-run-live.cy.ts",
    "test:e2e:het1-public:live": "node ../../scripts/run-het1-public-vertical-live-proof.cjs",
    "test:e2e:het2-public:live": "node ../../scripts/run-het2-public-vertical-live-proof.cjs",
    "test:e2e:native": "node ../../tools/ci/run-web-cypress-native.mjs",
    "test:e2e:startup-route-readiness": "node ../../tools/ci/run-web-cypress-native.mjs --spec cypress/e2e/shell/startup-route-readiness.cy.ts",
    "test:e2e:open": "node ../../tools/ci/run-web-cypress-native.mjs open",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node --max-old-space-size=4096 ../../node_modules/eslint/bin/eslint.js \"src/**/*.{ts,tsx}\" \"cypress/**/*.{ts,tsx}\" \"*.config.ts\" \"*.config.mjs\" \"scripts/**/*.{ts,mjs,js,cjs}\" --max-warnings 0",
    "test": "pnpm run test:unit:run && pnpm run test:presentation:run && pnpm run test:architecture:run",
    "test:unit": "pnpm run test:deps && pnpm run test:unit:run",
    "test:unit:run": "vitest run --config vitest.unit.config.ts",
    "test:presentation": "pnpm run test:deps && pnpm run test:presentation:run",
    "test:presentation:run": "vitest run --config vitest.presentation.config.ts",
    "test:architecture": "pnpm run test:deps && pnpm run test:architecture:run",
    "test:architecture:run": "vitest run --config vitest.architecture.config.ts",
    "test:canvas": "pnpm run test:deps && pnpm run test:canvas:run",
    "test:canvas:run": "vitest run --config vitest.canvas.config.ts",
    "test:canvas-unit": "pnpm run test:deps && pnpm run test:canvas-unit:run",
    "test:canvas-unit:run": "vitest run --config vitest.canvas-unit.config.ts",
    "test:canvas-presentation": "pnpm run test:deps && pnpm run test:canvas-presentation:run",
    "test:canvas-presentation:run": "vitest run --config vitest.canvas-presentation.config.ts",
    "test:canvas-architecture": "pnpm run test:deps && pnpm run test:canvas-architecture:run",
    "test:canvas-architecture:run": "vitest run --config vitest.canvas-architecture.config.ts",
    "test:monaco": "pnpm run test:deps && pnpm run test:monaco:run",
    "test:monaco:run": "vitest run --config vitest.monaco.config.ts",
    "test:shell-session": "pnpm run test:deps && pnpm run test:shell-session:run",
    "test:shell-session:run": "vitest run --config vitest.shell-session.config.ts",
    "test:workspace-services": "pnpm run test:deps && pnpm run test:workspace-services:run",
    "test:workspace-services:run": "vitest run --config vitest.workspace-services.config.ts",
    "test:changed": "pnpm exec tsx scripts/run-vitest-changed-suites.ts",
    "test:ci": "pnpm run test:deps && pnpm run test:unit:run && pnpm run test:presentation:run && pnpm run test:architecture:run",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@dvt/contracts": "workspace:*",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@octokit/rest": "^22.0.1",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.12",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.17",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.21",
    "@radix-ui/react-navigation-menu": "1.2.19",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.11",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.55.1",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-colorful": "5.6.1",
    "react-day-picker": "9.14.0",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.79.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.2",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "recharts": "3.8.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@types/picomatch": "4.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "4.13.0",
    "cypress": "15.18.1",
    "cypress-axe": "^1.7.0",
    "jsdom": "^29.1.0",
    "picomatch": "4.0.5",
    "start-server-and-test": "^2.0.11",
    "tailwindcss": "4.3.1",
    "vite": "8.0.8"
  }
}
