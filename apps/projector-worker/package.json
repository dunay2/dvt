{
  "name": "dvt-projector-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter \"dvt-projector-worker^...\" build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "pnpm --filter \"dvt-projector-worker^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "pretest": "pnpm --filter \"dvt-projector-worker^...\" build",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.4"
  }
}
