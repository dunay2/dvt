  "lint-staged": {
    "packages/@dvt/*/src/**/*.{ts,tsx}": [
      "eslint --fix --config tools/ci/eslint-precommit.config.cjs",
      "prettier --write"
    ],
    "packages/@dvt/*/test/**/*.{ts,tsx}": [
      "eslint --fix --config tools/ci/eslint-precommit.config.cjs",
      "prettier --write"
    ],
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --config tools/ci/eslint-precommit.config.cjs",
      "prettier --write"
    ],
    "apps/**/*.{html,css}": [
      "prettier --write"
    ],
    "specs/contracts/**/*.{md,json}": [
      "pnpm contracts:index:generate",
      "node -e \"const fs=require('fs');const cp=require('child_process');const p='specs/contracts/README.md';if(fs.existsSync(p)){cp.execSync('git add -- '+p,{stdio:'inherit'})}\""
    ],
    "scripts/**/*.{cjs,mjs}": [
      "eslint --fix --config tools/ci/eslint-precommit.config.cjs",
      "prettier --write"
    ],
    "tools/ci/**/*.{mjs,js}": [
      "eslint --fix --config tools/ci/eslint-precommit.config.cjs",
      "prettier --write"
    ],
    "tools/ci/**/*.cjs": [
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
