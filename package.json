{
  "name": "dvt",
  "version": "4.9.2",
  "type": "module",
  "description": "DVT - Workflow Engine Documentation and Code",
  "packageManager": "pnpm@10.28.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --ignore-pattern vitest.config.ts --max-warnings 0",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --fix",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"README.md\" --ignore-path .markdownlintignore --config .markdownlint-cli2.jsonc",
    "lint:determinism": "pnpm --filter @dvt/crypto build && pnpm --filter @dvt/plan-interpreter build && eslint \"packages/@dvt/engine/src/**/*.ts\" \"packages/@dvt/adapter-temporal/src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "type-check": "pnpm --filter @dvt/contracts build && pnpm --filter @dvt/artifacts build && pnpm --filter @dvt/planner build && pnpm --filter @dvt/observability build && pnpm --filter @dvt/crypto build && pnpm --filter @dvt/plan-interpreter build && tsc --noEmit",
    "type-check:apps": "pnpm --filter @dvt/web typecheck && pnpm --filter dvt-api typecheck && pnpm --filter dvt-outbox-worker typecheck",
    "build:apps": "pnpm --filter @dvt/web build && pnpm --filter dvt-api build && pnpm --filter dvt-outbox-worker build",
    "dev:web": "pnpm --filter @dvt/web dev",
    "verify:prepush": "pnpm test:contracts:compile && pnpm type-check && pnpm docs:gov:locations && node scripts/check-changed.cjs",
    "build": "pnpm -r build",
    "build:clean": "rimraf dist && pnpm -r build",
    "test": "pnpm -r test",
    "ci:affected:build": "pnpm -r --filter \"...[origin/main]\" --if-present run build",
    "ci:affected:test": "pnpm -r --filter \"...[origin/main]\" --if-present run test",
    "ci:affected:typecheck": "pnpm -r --filter \"...[origin/main]\" --if-present run typecheck",
    "test:engine": "pnpm --filter @dvt/engine test",
    "test:contracts": "pnpm --filter @dvt/contracts test",
    "test:contracts:compile": "pnpm --filter @dvt/contracts build",
    "test:adapter-postgres": "pnpm --filter @dvt/adapter-postgres test",
    "test:adapter-postgres:integration": "pnpm --filter @dvt/adapter-postgres test:integration",
    "test:adapter-temporal": "pnpm --filter @dvt/adapter-temporal test",
    "test:adapter-temporal:integration": "pnpm --filter @dvt/adapter-temporal test:integration",
    "test:cli": "pnpm --filter @dvt/cli test",
    "test:determinism": "pnpm --filter @dvt/engine test -- --grep determinism || true",
    "test:replay": "pnpm --filter @dvt/engine test -- --grep replay || true",
    "test:coverage": "pnpm -r test -- --coverage",
    "validate:contracts": "pnpm --filter @dvt/contracts run build && pnpm --filter @dvt/cli validate-contracts",
    "gen:ai-index": "node scripts/gen-ai-index.js",
    "rebuild:snapshots": "node scripts/rebuild-snapshots.js",
    "validate:glossary": "node scripts/validate-glossary-usage.cjs --mode error",
    "traceability:adr0": "pnpm --filter @dvt/traceability-service build && pnpm --filter @dvt/traceability-service trace validate-and-build-manifest --config ../../../traceability.config.json --repoRoot ../../.. --component \"@dvt/traceability-service\" --componentVersion \"0.1.0\" --repoSha \"local\"",
    "db:migrate": "node scripts/db-migrate.cjs",
    "contracts:index:generate": "node scripts/generate-contract-index.cjs",
    "contracts:index:check": "pnpm contracts:index:generate && git diff --quiet -- specs/contracts/README.md",
    "contracts:rfc2119:validate": "node scripts/validate-rfc2119.cjs",
    "contracts:glossary:validate": "node scripts/validate-glossary-usage.cjs --mode warn",
    "contracts:references:validate": "node scripts/validate-references.cjs",
    "contracts:idempotency:validate": "node scripts/validate-idempotency-vectors.cjs",
    "contracts:examples:validate": "node scripts/validate-executable-examples.cjs",
    "golden:validate": "pnpm --filter @dvt/cli run-golden-paths",
    "docs:sync": "node scripts/sync-docs.cjs",
    "docs:quality:check": "node scripts/docs-quality-check.cjs",
    "docs:doctor": "node scripts/docs-doctor.cjs",
    "docs:canonical:check": "node scripts/docs-canonical-check.cjs",
    "docs:canonical:fix": "node scripts/docs-canonical-fix.cjs",
    "docs:status:generate": "node scripts/generate-code-status.cjs",
    "docs:status:check": "pnpm docs:status:generate && git diff --exit-code -- docs/planning/status/generated-code-state.md",
    "docs:capability:generate": "node scripts/generate-capability-coverage.cjs",
    "docs:capability:check": "pnpm docs:capability:generate && git diff --exit-code -- docs/planning/status/generated-capability-coverage.md",
    "docs:gov:locations": "node scripts/check-markdown-locations.cjs",
    "docs:gov:adr": "tsx tools/docs/check-adr-catalog.ts",
    "docs:gov:filenames": "tsx tools/docs/check-filenames.ts",
    "docs:gov:filenames:strict": "tsx tools/docs/check-filenames.ts --strict",
    "docs:gov:frontmatter": "tsx tools/docs/check-frontmatter.ts",
    "docs:gov:links": "tsx tools/docs/check-links.ts",
    "docs:gov:links:changed": "tsx tools/docs/check-links.ts --changed-only",
    "docs:gov:refs": "tsx tools/docs/check-governance-references.ts",
    "docs:gov:manifest": "tsx tools/docs/generate-docs-manifest.ts",
    "docs:gov:planner-stage-1-1": "tsx tools/docs/validate-planner-stage-1-1-manifest.ts",
    "docs:gov": "pnpm docs:gov:filenames && pnpm docs:gov:adr && pnpm docs:gov:frontmatter && pnpm docs:gov:links:changed && pnpm docs:gov:refs && pnpm docs:gov:planner-stage-1-1",
    "docs:ci": "pnpm docs:sync:check && pnpm docs:quality:check && pnpm docs:doctor && pnpm docs:canonical:check && pnpm docs:status:check && pnpm docs:capability:check && pnpm docs:gov:locations && pnpm docs:gov",
    "docs:sync:check": "pnpm docs:sync && git diff --exit-code -- docs/index.md docs/adr/index.md docs/adr/_drafts/index.md docs/adr/_archive/index.md docs/concepts/index.md docs/architecture/index.md docs/contracts/index.md docs/contracts/engine/index.md docs/contracts/planner/index.md docs/contracts/shared/index.md docs/evidence/index.md docs/planning/index.md docs/planning/proposals/index.md docs/planning/reviews/index.md docs/planning/status/index.md docs/guides/index.md docs/risk-register/index.md docs/risk-register/adapters/index.md docs/risk-register/quality/index.md docs/runbooks/index.md docs/archive/index.md mkdocs.yml",
    "docs:serve": "pnpm docs:sync && zensical serve",
    "docs:build": "pnpm docs:sync && zensical build",
    "versioning-check": "node -e \"console.log('Versioning check: OK')\"",
    "release": "echo \"Releases are managed by release-please workflow\"",
    "prepare": "node scripts/setup-git-hooks.cjs",
    "precommit": "lint-staged && pnpm lint:determinism"
  },
  "lint-staged": {
    "packages/@dvt/*/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/@dvt/*/test/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "specs/contracts/**/*.{md,json}": [
      "pnpm contracts:index:generate",
      "node -e \"const fs=require('fs');const cp=require('child_process');const p='specs/contracts/README.md';if(fs.existsSync(p)){cp.execSync('git add -- '+p,{stdio:'inherit'})}\""
    ],
    "docs/**/*.{md,txt}": [
      "pnpm docs:sync",
      "node -e \"const cp=require('child_process');cp.execSync('git add -- docs/index.md docs/adr/index.md docs/adr/_drafts/index.md docs/adr/_archive/index.md docs/concepts/index.md docs/architecture/index.md docs/contracts/index.md docs/contracts/engine/index.md docs/contracts/planner/index.md docs/contracts/shared/index.md docs/evidence/index.md docs/planning/index.md docs/planning/proposals/index.md docs/planning/reviews/index.md docs/planning/status/index.md docs/guides/index.md docs/risk-register/index.md docs/risk-register/adapters/index.md docs/risk-register/quality/index.md docs/runbooks/index.md docs/archive/index.md mkdocs.yml',{stdio:'inherit'})\""
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dunay2/dvt.git"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "temporal",
    "dbt",
    "data-engineering"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.1.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "25.5.0",
      "vitest": "3.2.4",
      "@vitest/ui": "3.2.4",
      "@vitest/coverage-v8": "3.2.4",
      "@vitest/expect": "3.2.4",
      "@vitest/runner": "3.2.4",
      "@vitest/snapshot": "3.2.4",
      "@vitest/spy": "3.2.4",
      "@vitest/utils": "3.2.4"
    }
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  }
}
