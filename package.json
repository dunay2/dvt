{
  "name": "dvt",
  "version": "5.18.0",
  "type": "module",
  "description": "DVT - Workflow Engine Documentation and Code",
  "packageManager": "pnpm@10.28.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "commit": "node scripts/commit.cjs",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --ignore-pattern vitest.config.ts --max-warnings 0",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --fix",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"README.md\" --ignore-path .markdownlintignore --config .markdownlint-cli2.jsonc",
    "lint:md:changed": "node scripts/lint-markdown-changed.cjs",
    "lint:determinism": "pnpm --filter @dvt/crypto build && pnpm --filter @dvt/plan-interpreter build && eslint \"packages/@dvt/engine/src/**/*.ts\" \"packages/@dvt/adapter-temporal/src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "format:md:changed": "node scripts/format-markdown-changed.cjs",
    "fix:changed": "node scripts/fix-changed.cjs",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "type-check": "pnpm --filter @dvt/contracts build && pnpm --filter @dvt/artifacts build && pnpm --filter @dvt/planner build && pnpm --filter @dvt/observability build && pnpm --filter @dvt/crypto build && pnpm --filter @dvt/plan-interpreter build && tsc --noEmit",
    "type-check:apps": "pnpm --filter @dvt/web typecheck && pnpm --filter dvt-api typecheck && pnpm --filter dvt-outbox-worker typecheck && pnpm --filter dvt-temporal-worker typecheck",
    "build:apps": "pnpm --filter @dvt/web build && pnpm --filter dvt-api build && pnpm --filter dvt-outbox-worker build && pnpm --filter dvt-temporal-worker build",
    "dev:web": "pnpm --filter @dvt/web dev",
    "dev:api": "pnpm --filter dvt-api dev",
    "dev:app": "node scripts/run-dev-stack.cjs",
    "dev:app:test": "node scripts/run-dev-stack.cjs --test-only",
    "ci:docs": "pnpm docs:workboard:check && pnpm docs:sync:check && pnpm docs:quality:check && pnpm docs:doctor && pnpm docs:gov:locations && pnpm docs:canonical:check && pnpm docs:status:check && pnpm docs:capability:check && pnpm docs:gov:manifest:check && pnpm docs:gov:generated-policy && pnpm docs:governance:unit-coverage && pnpm docs:governance:document-unit-map:check && pnpm docs:governance:file-component-index:check && pnpm docs:governance:file-fingerprint-baseline:check && pnpm docs:feature-mechanization && pnpm docs:feature-mechanization:implementation",
    "ci:code": "pnpm type-check && pnpm test && pnpm lint:determinism",
    "ci:full": "pnpm ci:docs && pnpm ci:code && pnpm test:coverage:engine",
    "preflight:affected": "pnpm ci:affected:typecheck && pnpm ci:affected:test",
    "verify:changed": "node scripts/verify-changed.cjs",
    "ops:ar-c2:evidence": "node tools/ops/ar-c2-evidence-collector.mjs",
    "qa:artifact:check": "node scripts/qa-artifact-check.cjs",
    "verify:prepush": "node scripts/docs-workboard-check-changed.cjs && pnpm docs:gov:locations -- --changed-only && pnpm docs:gov:filenames:changed && pnpm docs:gov:frontmatter:changed && pnpm docs:gov:generated-policy && pnpm docs:governance:unit-coverage && pnpm docs:governance:document-unit-map:check && pnpm docs:governance:file-component-index:check && pnpm docs:governance:file-fingerprint-baseline:check && pnpm docs:feature-mechanization && pnpm docs:feature-mechanization:implementation && pnpm docs:arc:evidence:check -- --changed-only && pnpm qa:artifact:check && pnpm lint:md:changed && node scripts/check-changed.cjs && node scripts/check-forbidden-tracked-files.cjs && node scripts/type-check-prepush.cjs",
    "pr:validate-title": "node scripts/validate-pr-title.cjs",
    "build": "turbo run build",
    "build:clean": "rimraf .turbo && turbo run build --force",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @dvt/web test",
    "test:web:e2e": "pnpm --filter @dvt/web test:e2e",
    "ci:affected:build": "node scripts/run-turbo-workspace-task.cjs build",
    "ci:affected:test": "node scripts/run-turbo-workspace-task.cjs test",
    "ci:affected:typecheck": "node scripts/run-turbo-workspace-task.cjs typecheck",
    "test:engine": "pnpm --filter @dvt/engine test",
    "test:contracts": "pnpm --filter @dvt/contracts test",
    "test:contracts:compile": "pnpm --filter @dvt/contracts build",
    "test:adapter-postgres": "pnpm --filter @dvt/adapter-postgres test",
    "test:adapter-postgres:integration": "pnpm --filter @dvt/adapter-postgres test:integration",
    "test:adapter-temporal": "pnpm --filter @dvt/adapter-temporal test",
    "test:adapter-temporal:integration": "pnpm --filter @dvt/adapter-temporal run test:integration:local",
    "test:adapter-temporal:integration:transformation": "pnpm --filter @dvt/adapter-temporal run test:integration:transformation:local",
    "test:adapter-temporal:integration:postgres": "pnpm --filter @dvt/adapter-temporal run test:integration:postgres:local",
    "test:adapter-temporal:integration:postgres:docker": "node scripts/run-temporal-postgres-proof.cjs test --reset",
    "proof:temporal:postgres:up": "node scripts/run-temporal-postgres-proof.cjs up",
    "proof:temporal:postgres:test": "node scripts/run-temporal-postgres-proof.cjs test",
    "proof:temporal:postgres:reset": "node scripts/run-temporal-postgres-proof.cjs reset",
    "proof:temporal:postgres:cleanup": "node scripts/run-temporal-postgres-proof.cjs cleanup",
    "proof:temporal:postgres:down": "node scripts/run-temporal-postgres-proof.cjs down",
    "test:api": "pnpm --filter dvt-api test",
    "test:cli": "pnpm --filter @dvt/cli test",
    "test:planner": "pnpm --filter @dvt/planner test",
    "test:determinism": "pnpm --filter @dvt/engine test --testNamePattern determinism",
    "test:replay": "pnpm --filter @dvt/engine test --testNamePattern replay",
    "test:coverage": "pnpm -r test -- --coverage",
    "test:coverage:engine": "pnpm --filter @dvt/engine test -- --coverage",
    "test:ci-tools": "node --test tools/ci/*.test.mjs",
    "validate:contracts": "pnpm --filter @dvt/contracts run build && pnpm --filter @dvt/cli validate-contracts",
    "gen:ai-index": "node scripts/gen-ai-index.js",
    "rebuild:snapshots": "node scripts/rebuild-snapshots.js",
    "validate:glossary": "node scripts/validate-glossary-usage.cjs --mode error",
    "traceability:adr0": "pnpm --filter @dvt/traceability-service build && pnpm --filter @dvt/traceability-service trace validate-and-build-manifest --config ../../../traceability.config.json --repoRoot ../../.. --component \"@dvt/traceability-service\" --componentVersion \"0.1.0\" --repoSha \"local\"",
    "db:migrate": "node scripts/db-migrate.cjs",
    "contracts:index:generate": "node scripts/generate-contract-index.cjs",
    "contracts:index:check": "pnpm contracts:index:generate && git diff --quiet -- specs/contracts/README.md",
    "contracts:rfc2119:validate": "node scripts/validate-rfc2119.cjs",
    "contracts:glossary:validate": "node scripts/validate-glossary-usage.cjs --mode warn",
    "contracts:references:validate": "node scripts/validate-references.cjs",
    "contracts:idempotency:validate": "node scripts/validate-idempotency-vectors.cjs",
    "contracts:examples:validate": "node scripts/validate-executable-examples.cjs",
    "golden:validate": "pnpm --filter @dvt/cli run-golden-paths",
    "docs:sync": "node scripts/sync-docs.cjs && node scripts/generate-planning-lanes.cjs",
    "docs:planning:lanes:generate": "node scripts/generate-planning-lanes.cjs",
    "docs:planning:lanes:generate:isolated": "node scripts/generate-planning-lanes.cjs --output-root .generated-docs",
    "docs:planning:lanes:check": "pnpm docs:planning:lanes:generate",
    "docs:planning:generated:check": "node scripts/docs-planning-generated-check.cjs",
    "docs:workboard:check": "pnpm docs:planning:generated:check",
    "docs:quality:check": "node scripts/docs-quality-check.cjs",
    "docs:doctor": "node scripts/docs-doctor.cjs",
    "docs:planning:last-reviewed:backfill": "node scripts/backfill-planning-last-reviewed.cjs",
    "docs:canonical:check": "node scripts/docs-canonical-check.cjs",
    "docs:pr:fast": "node scripts/docs-pr-local.cjs --mode fast",
    "docs:pr:full": "node scripts/docs-pr-local.cjs --mode full",
    "docs:pr:create": "node scripts/docs-pr-create.cjs",
    "docs:canonical:fix": "node scripts/docs-canonical-fix.cjs",
    "docs:status:generate": "node scripts/generate-code-status.cjs",
    "docs:status:check": "pnpm docs:status:generate",
    "docs:workboard:generate": "node scripts/generate-workboard.cjs",
    "docs:workboard:generate:isolated": "node scripts/generate-workboard.cjs --output-root .generated-docs",
    "docs:planning:preview:isolated": "pnpm docs:planning:lanes:generate:isolated && pnpm docs:workboard:generate:isolated",
    "docs:capability:generate": "node scripts/generate-capability-coverage.cjs",
    "docs:capability:check": "pnpm docs:capability:generate",
    "docs:gov:locations": "node scripts/check-markdown-locations.cjs",
    "docs:arc:evidence:check": "node scripts/validate-arc-evidence-frontmatter.cjs",
    "docs:gov:adr": "tsx tools/docs/check-adr-catalog.ts",
    "docs:gov:filenames": "tsx tools/docs/check-filenames.ts",
    "docs:gov:filenames:changed": "tsx tools/docs/check-filenames.ts --changed-only --strict",
    "docs:gov:filenames:strict": "tsx tools/docs/check-filenames.ts --strict",
    "docs:gov:frontmatter": "tsx tools/docs/check-frontmatter.ts",
    "docs:gov:frontmatter:changed": "tsx tools/docs/check-frontmatter.ts --changed-only",
    "docs:gov:links": "tsx tools/docs/check-links.ts",
    "docs:gov:links:changed": "tsx tools/docs/check-links.ts --changed-only",
    "docs:gov:refs": "tsx tools/docs/check-governance-references.ts",
    "docs:gov:manifest": "tsx tools/docs/generate-docs-manifest.ts",
    "docs:gov:manifest:check": "pnpm docs:gov:manifest && git diff --exit-code -- docs/.manifest.json",
    "docs:gov:generated-policy": "node scripts/check-generated-docs-policy.cjs",
    "docs:governance:unit-coverage": "node scripts/check-governance-unit-coverage.cjs",
    "test:docs:governance:unit-coverage": "node --test scripts/check-governance-unit-coverage.test.cjs",
    "docs:feature-mechanization": "node scripts/check-feature-mechanization.cjs",
    "docs:feature-mechanization:tf-e2-m-b": "node scripts/check-feature-mechanization.cjs --feature TF-E2-M-B",
    "docs:feature-mechanization:tf-e2-m-c": "node scripts/check-feature-mechanization.cjs --feature TF-E2-M-C --implementation",
    "docs:feature-mechanization:implementation": "node scripts/check-feature-mechanization.cjs --implementation",
    "test:docs:feature-mechanization": "node --test scripts/check-feature-mechanization.test.cjs",
    "docs:governance:document-unit-map": "node scripts/generate-governance-document-unit-map.cjs",
    "docs:governance:document-unit-map:check": "node scripts/generate-governance-document-unit-map.cjs --check",
    "test:docs:governance:document-unit-map": "node --test scripts/generate-governance-document-unit-map.test.cjs",
    "docs:governance:file-component-index": "node scripts/generate-governance-file-component-index.cjs",
    "docs:governance:file-component-index:check": "node scripts/generate-governance-file-component-index.cjs --check",
    "test:docs:governance:file-component-index": "node --test scripts/generate-governance-file-component-index.test.cjs",
    "docs:governance:file-fingerprint-baseline": "node scripts/check-governance-file-fingerprint-baseline.cjs --write",
    "docs:governance:file-fingerprint-baseline:check": "node scripts/check-governance-file-fingerprint-baseline.cjs --check",
    "test:docs:governance:file-fingerprint-baseline": "node --test scripts/check-governance-file-fingerprint-baseline.test.cjs",
    "docs:gov:planner-stage-1-1": "tsx tools/docs/validate-planner-stage-1-1-manifest.ts",
    "docs:gov": "pnpm docs:gov:filenames && pnpm docs:gov:filenames:changed && pnpm docs:gov:adr && pnpm docs:gov:frontmatter && pnpm docs:gov:frontmatter:changed && pnpm docs:gov:links:changed && pnpm docs:gov:refs && pnpm docs:gov:manifest && pnpm docs:gov:generated-policy && pnpm docs:governance:unit-coverage && pnpm docs:governance:document-unit-map:check && pnpm docs:governance:file-component-index:check && pnpm docs:governance:file-fingerprint-baseline:check && pnpm docs:feature-mechanization && pnpm docs:feature-mechanization:implementation && pnpm docs:gov:planner-stage-1-1",
    "docs:ci": "pnpm docs:sync && pnpm docs:workboard:generate && pnpm docs:status:generate && pnpm docs:capability:generate && pnpm docs:quality:check && pnpm docs:doctor && pnpm docs:canonical:check && pnpm docs:gov:locations && pnpm docs:gov",
    "docs:sync:check": "pnpm docs:sync && git diff --exit-code -- docs/index.md docs/adr/index.md docs/adr/_drafts/index.md docs/adr/_archive/index.md docs/concepts/index.md docs/architecture/index.md docs/contracts/index.md docs/contracts/engine/index.md docs/contracts/planner/index.md docs/contracts/shared/index.md docs/evidence/index.md docs/guides/index.md docs/risk-register/index.md docs/risk-register/adapters/index.md docs/risk-register/quality/index.md docs/runbooks/index.md docs/archive/index.md",
    "docs:serve": "pnpm docs:sync && pnpm docs:workboard:generate && zensical serve --config-file zensical.yml",
    "docs:build": "pnpm docs:sync && pnpm docs:workboard:generate && zensical build --config-file zensical.yml --clean",
    "versioning-check": "node -e \"console.log('Versioning check: OK')\"",
    "release": "echo \"Releases are managed by release-please workflow\"",
    "prepare": "node scripts/setup-git-hooks.cjs",
    "precommit:determinism": "node scripts/run-determinism-precommit.cjs",
    "precommit": "lint-staged && pnpm precommit:determinism"
  },
  "lint-staged": {
    "packages/@dvt/*/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/@dvt/*/test/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/**/*.{html,css}": [
      "prettier --write"
    ],
    "specs/contracts/**/*.{md,json}": [
      "pnpm contracts:index:generate",
      "node -e \"const fs=require('fs');const cp=require('child_process');const p='specs/contracts/README.md';if(fs.existsSync(p)){cp.execSync('git add -- '+p,{stdio:'inherit'})}\""
    ],
    "scripts/**/*.{cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tools/ci/**/*.{mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dunay2/dvt.git"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "temporal",
    "dbt",
    "data-engineering"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "semver": "^7.7.4",
    "tslib": "2.8.1",
    "tsx": "^4.21.0",
    "turbo": "2.9.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "25.6.0",
      "vitest": "3.2.4",
      "@vitest/ui": "3.2.4",
      "@vitest/coverage-v8": "3.2.4",
      "@vitest/expect": "3.2.4",
      "@vitest/runner": "3.2.4",
      "@vitest/snapshot": "3.2.4",
      "@vitest/spy": "3.2.4",
      "semver": "7.7.4",
      "@vitest/utils": "3.2.4",
      "minimatch@10.2.4": "10.1.2"
    }
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  }
}
