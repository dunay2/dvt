{
  "version": "1.0",
  "governedPaths": [
    "packages/@dvt/traceability-service/src/**/*.ts",
    "packages/@dvt/engine/src/**/*.ts",
    "packages/@dvt/contracts/src/**/*.ts",
    "packages/@dvt/adapter-temporal/src/**/*.ts",
    "packages/@dvt/adapter-temporal/test/**/*.ts",
    "packages/@dvt/adapter-postgres/src/**/*.ts",
    "apps/web/src/app/services/capabilities/capabilitiesPort.ts",
    "apps/web/src/app/plugins/registry.ts",
    "apps/web/src/app/stores/authorizationStore.ts",
    "scripts/planning-db-query.cjs",
    "!**/*.d.ts",
    "!**/node_modules/**",
    "!**/dist/**"
  ],
  "exemptPaths": ["packages/frontend/**", "**/*.stories.tsx"],
  "validation": {
    "requireDecision": true,
    "requireConsequence": false,
    "strictMode": true,
    "failOnMissingVersion": true
  },
  "adrCatalog": {
    "path": "docs/adr",
    "pattern": "[Aa][Dd][Rr]-.*\\.md$"
  },
  "regressionBaseline": {
    "path": "traceability.issue-baseline.json"
  }
}
