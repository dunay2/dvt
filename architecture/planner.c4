model {
  plannerModel = package '@dvt/planner' {
    #asIs
    description 'Deterministic planning bounded context. Validates canonical input, derives executable closure and builds immutable ExecutionPlan material. It does not execute or persist runtime state.'

    metadata {
      repository 'dunay2/dvt'
      baselineSha '42504563629f0b998d8a3382ea839eead99a36d1'
      sourceRoot 'packages/@dvt/planner'
      provenance 'SOURCE-FIRST'
    }

    link https://github.com/dunay2/dvt/tree/42504563629f0b998d8a3382ea839eead99a36d1/packages/%40dvt/planner 'Pinned package tree'

    sourceEvidence = component 'Source evidence' { #sourceDerived }
    publicBoundary = component 'PlannerFacade + stable boundary' {
      #asIs
      description 'src/index.ts exposes PlannerFacade as the stable public entry; the domain Planner remains internal.'
    }
    executableSubgraph = component 'Executable subgraph derivation' { #asIs }
    envelopeMapping = component 'Input normalization + graph mapping' { #asIs }
    planningPipeline = component 'Deterministic planning pipeline' {
      #asIs
      description 'Validates, builds the graph, applies policy/selection, orders nodes, constructs steps and assembles immutable plan material.'
    }
    graph = component 'Graph construction + topology' { #asIs }
    selection = component 'Node selection' { #asIs }
    planAssembly = component 'Immutable plan assembly' { #asIs }
    stepFactory = component 'Execution-step factory' { #asIs }
    behaviorContracts = contract 'Planner-owned behavior contracts' { #asIs }
    runtimeClock = component 'Runtime clock boundary' { #asIs }
    artifactCompatibilityBridge = component 'Artifact compatibility bridge' {
      #asIs
      description 'Explicit transitional re-export of ICompiledCodeStorage from @dvt/artifacts; source warns against new imports.'
    }

    publicBoundary .uses envelopeMapping 'normalizes planner input'
    publicBoundary .delegates planningPipeline 'buildPlan'
    publicBoundary .delegates executableSubgraph 'derive executable closure'
    publicBoundary .uses behaviorContracts 'behavior boundaries'
    planningPipeline .uses graph 'dependency graph + order'
    planningPipeline .uses selection 'selected nodes'
    planningPipeline .uses stepFactory 'execution responsibilities'
    planningPipeline .delegates planAssembly 'immutable plan'
    planningPipeline .uses runtimeClock 'timing only'
  }
}

views {
  view plannerBoundary of plannerModel {
    title 'DVT+ Planner — Responsibilities, components and source evidence'
    description 'Source-first Planner view pinned to main@42504563.'
    include sourceEvidence with { navigateTo plannerSourceInventory }
    include publicBoundary with { navigateTo plannerFiles_publicBoundary }
    include executableSubgraph with { navigateTo plannerFiles_executableSubgraph }
    include envelopeMapping with { navigateTo plannerFiles_envelopeMapping }
    include planningPipeline with { navigateTo plannerFiles_planningPipeline }
    include graph with { navigateTo plannerFiles_graph }
    include selection with { navigateTo plannerFiles_selection }
    include planAssembly with { navigateTo plannerFiles_planAssembly }
    include stepFactory with { navigateTo plannerFiles_stepFactory }
    include behaviorContracts with { navigateTo plannerFiles_behaviorContracts }
    include runtimeClock with { navigateTo plannerFiles_runtimeClock }
    include artifactCompatibilityBridge with { navigateTo plannerFiles_artifactCompatibilityBridge }
    autoLayout LeftRight
  }
}
