model {
  temporal = external 'Temporal' {
    #externalSystem
    description 'Current workflow provider runtime.'
  }

  postgres = external 'PostgreSQL' {
    #externalSystem
    description 'Persistent operational store behind the PostgreSQL adapter.'
  }

  dvt = system 'DVT+' {
    #asIs
    description 'Visual, auditable and deterministic control plane for data transformations.'

    metadata {
      repository 'dunay2/dvt'
      baselineSha '77c338cf785cbaefc782490c4de22ee683274d46'
      status 'manual-spike'
    }

    link https://github.com/dunay2/dvt/tree/77c338cf785cbaefc782490c4de22ee683274d46 'Source baseline'

    api = app 'apps/api' {
      #asIs
      description 'Authenticated command/query boundary and composition root.'
      link https://github.com/dunay2/dvt/tree/77c338cf785cbaefc782490c4de22ee683274d46/apps/api 'Source'
    }

    engine = package '@dvt/engine' {
      #asIs
      description 'Owns canonical run lifecycle, command/read governance and provider delegation. It executes an admitted plan; it does not plan.'
      link https://github.com/dunay2/dvt/tree/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src 'Package source'

      sourceEvidence = component 'Source evidence' {
        #sourceDerived
        description 'Generated from the pinned Git tree. Open this view to inspect every tracked Engine file by folder.'
        metadata {
          provenance 'SOURCE-DERIVED'
          sourceRoot 'packages/@dvt/engine'
          baselineSha '77c338cf785cbaefc782490c4de22ee683274d46'
        }
        navigateTo engineSourceInventory
      }

      workflowPort = port 'IWorkflowEngine' {
        #asIs
        description 'Application-facing behavior port: start, recover, cancel, canonical status and signal.'
        link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/ports/IWorkflowEngine.ts 'Source'
        navigateTo engineFiles_workflowPort
      }

      workflowFacade = component 'WorkflowEngine facade' {
        #asIs
        description 'Normalizes public inputs and delegates each operation to an explicit use case.'
        link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/core/WorkflowEngine.ts 'Source'
        navigateTo engineFiles_workflowFacade
      }

      useCases = component 'Workflow engine use cases' {
        #asIs
        description 'Explicit application operations behind the facade.'
        navigateTo engineFiles_useCases

        startRun = component 'Start run' {
          #asIs
          description 'Resolves initial run context, opens telemetry context and delegates start-run orchestration.'
          link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/application/workflow-engine-use-cases/WorkflowStartRunUseCase.ts 'Source'
          navigateTo engineFiles_startRun
        }
        recoverRun = component 'Recover run' {
          #asIs
          description 'Creates recovery execution through explicit recovery semantics.'
          navigateTo engineFiles_recoverRun
        }
        cancelRun = component 'Cancel run' {
          #asIs
          description 'Applies canonical cancellation semantics.'
          navigateTo engineFiles_cancelRun
        }
        status = component 'Canonical status' {
          #asIs
          description 'Reads canonical status from persisted event/snapshot state; never asks the provider.'
          navigateTo engineFiles_status
        }
        signal = component 'Signal run' {
          #asIs
          description 'Validates and delegates governed lifecycle signals.'
          navigateTo engineFiles_signal
        }
      }

      startPipeline = component 'StartRun application pipeline' {
        #asIs
        description 'Coordinates admission, intent creation, provider dispatch, state writes, telemetry and failure handling.'
        link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/application/StartRunApplicationService.ts 'Source'
        navigateTo engineFiles_startPipeline

        coordinator = component 'StartRun coordinator' {
          #asIs
          description 'Application-layer coordinator that sequences admission, intent, dispatch, telemetry and failure handling.'
          link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/application/StartRunApplicationService.ts 'Source'
          navigateTo engineFiles_coordinator
        }
        admission = component 'Admission & integrity' {
          #asIs
          description 'Admits the provider/capabilities and verifies immutable plan material before dispatch.'
          navigateTo engineFiles_admission
        }
        intent = component 'Pre-dispatch intent' {
          #asIs
          description 'Records crash-consistent start intent before provider dispatch.'
          navigateTo engineFiles_intent
        }
        execution = component 'Execution dispatch' {
          #asIs
          description 'Dispatches admitted execution through the provider port and persists lifecycle facts.'
          navigateTo engineFiles_execution
        }
        failure = component 'Failure policy' {
          #asIs
          description 'Reconciles start failures while preserving canonical state and intent invariants.'
          navigateTo engineFiles_failure
        }
      }

      providerPort = port 'IProviderAdapter' {
        #asIs
        description 'Replaceable provider boundary for start, cancel, signal, capabilities and provider diagnostics.'
        link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/adapters/IProviderAdapter.ts 'Source'
        navigateTo engineFiles_providerPort
      }

      statePort = port 'IRunStateStore' {
        #asIs
        description 'Canonical run-event and snapshot persistence boundary.'
        link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/engine/src/ports/IRunStateStore.ts 'Source'
        navigateTo engineFiles_statePort
      }

      planIntegrityPort = port 'IPlanIntegrityValidator' {
        #asIs
        description 'Verifies immutable plan identity before provider dispatch.'
        navigateTo engineFiles_planIntegrityPort
      }

      workflowFacade .implements workflowPort 'implements public engine behavior'
      workflowFacade .delegates useCases 'delegates operations'
      useCases.startRun .delegates startPipeline.coordinator 'starts admitted run'
      startPipeline.coordinator .uses startPipeline.admission 'admit provider + verify plan'
      startPipeline.coordinator .uses startPipeline.intent 'record pre-dispatch intent'
      startPipeline.coordinator .uses startPipeline.execution 'dispatch admitted run'
      startPipeline.coordinator .uses startPipeline.failure 'apply failure policy on error'
      startPipeline.admission .uses planIntegrityPort 'verifies plan integrity'
      startPipeline.execution .delegates providerPort 'dispatches admitted run'
      startPipeline.execution .persists statePort 'writes lifecycle facts'
      useCases.status .uses statePort 'reads canonical event/snapshot state'
    }

    temporalAdapter = adapter '@dvt/adapter-temporal' {
      #asIs
      description 'Current provider adapter. Maps DVT run lifecycle operations to Temporal workflow primitives.'
      link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/adapter-temporal/src/TemporalAdapter.ts 'Source'
    }

    postgresAdapter = adapter '@dvt/adapter-postgres' {
      #asIs
      description 'Transactional PostgreSQL adapter for runtime state and related stores.'
      link https://github.com/dunay2/dvt/blob/77c338cf785cbaefc782490c4de22ee683274d46/packages/@dvt/adapter-postgres/src/index.ts 'Source'
    }

    api .calls engine.workflowPort 'run commands / canonical queries'
    temporalAdapter .implements engine.providerPort 'implements provider boundary'
    postgresAdapter .implements engine.statePort 'implements run-state boundary'
  }

  dvt.temporalAdapter .delegates temporal 'Temporal workflow primitives'
  dvt.postgresAdapter .persists postgres 'transactional runtime state'
}

views {
  view index {
    title 'DVT+ — Architecture Visibility Spike'
    include dvt
    include temporal
    include postgres
  }

  view engineBoundary of dvt.engine {
    title 'DVT+ Engine — Responsibilities, components and ports'
    description 'Source-first view pinned to main@77c338cf. Engine governs run lifecycle and delegates execution through replaceable ports.'
    include *
    include dvt.api
    include dvt.temporalAdapter
    include dvt.postgresAdapter
    include temporal
    include postgres
    autoLayout LeftRight
  }

  view engineUseCases of dvt.engine.useCases {
    title 'Engine — Application use cases'
    include *
    include dvt.engine.workflowFacade
    include dvt.engine.startPipeline
    autoLayout LeftRight
  }

  view startRunPipeline of dvt.engine.startPipeline {
    title 'Engine — StartRun pipeline'
    include *
    include dvt.engine.useCases.startRun
    include dvt.engine.providerPort
    include dvt.engine.statePort
    include dvt.engine.planIntegrityPort
    include dvt.temporalAdapter
    include dvt.postgresAdapter
    autoLayout LeftRight
  }

  dynamic view startRunFlow {
    title 'Engine — startRun control flow'
    dvt.api -> dvt.engine.workflowPort 'startRun(PlanRef, RunContext)'
    dvt.engine.workflowPort -> dvt.engine.workflowFacade 'public behavior contract'
    dvt.engine.workflowFacade -> dvt.engine.useCases.startRun 'normalize and delegate'
    dvt.engine.useCases.startRun -> dvt.engine.startPipeline.coordinator 'resolved context + trace context'
    dvt.engine.startPipeline.coordinator -> dvt.engine.startPipeline.admission 'admit provider + verify plan'
    dvt.engine.startPipeline.admission -> dvt.engine.planIntegrityPort 'verify immutable PlanRef'
    dvt.engine.startPipeline.coordinator -> dvt.engine.startPipeline.intent 'record pre-dispatch intent'
    dvt.engine.startPipeline.coordinator -> dvt.engine.startPipeline.execution 'dispatch admitted run'
    dvt.engine.startPipeline.execution -> dvt.engine.providerPort 'startRun'
    dvt.engine.providerPort -> dvt.temporalAdapter 'provider implementation'
    dvt.temporalAdapter -> temporal 'start Temporal workflow'
    dvt.engine.startPipeline.execution -> dvt.engine.statePort 'persist lifecycle facts'
    dvt.engine.statePort -> dvt.postgresAdapter 'state-store implementation'
    dvt.postgresAdapter -> postgres 'transactional writes'
  }
}
