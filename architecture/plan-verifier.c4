model {
  planVerifierModel = package '@dvt/plan-verifier' {
    #asIs
    description 'Admission-time verification for ExecutionPlan compatibility, plan version and step-type configuration. It verifies; it does not replan.'
    metadata {
      repository 'dunay2/dvt'
      baselineSha '42504563629f0b998d8a3382ea839eead99a36d1'
      sourceRoot 'packages/@dvt/plan-verifier'
      provenance 'SOURCE-FIRST'
    }
    link https://github.com/dunay2/dvt/tree/42504563629f0b998d8a3382ea839eead99a36d1/packages/%40dvt/plan-verifier 'Pinned package tree'

    sourceEvidence = component 'Source evidence' { #sourceDerived }
    publicBoundary = component 'Plan Verifier public boundary' { #asIs }
    verification = component 'Plan verification' { #asIs }
    planVersion = component 'Plan-version compatibility' { #asIs }
    stepTypeConfig = component 'Step-type configuration verification' { #asIs }
    errors = component 'Verification errors' { #asIs }

    publicBoundary .delegates verification 'verification entry point'
    verification .uses planVersion 'version compatibility'
    verification .uses stepTypeConfig 'step-type config'
    verification .uses errors 'rejects invalid plans'
  }
}

views {
  view planVerifierBoundary of planVerifierModel {
    title 'DVT+ Plan Verifier — Admission compatibility'
    description 'Source-first Plan Verifier view pinned to main@42504563.'
    include sourceEvidence with { navigateTo planVerifierSourceInventory }
    include publicBoundary with { navigateTo plan-verifierFiles_publicBoundary }
    include verification with { navigateTo plan-verifierFiles_verification }
    include planVersion with { navigateTo plan-verifierFiles_planVersion }
    include stepTypeConfig with { navigateTo plan-verifierFiles_stepTypeConfig }
    include errors with { navigateTo plan-verifierFiles_errors }
    autoLayout LeftRight
  }
}
