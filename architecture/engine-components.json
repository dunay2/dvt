{
  "schemaVersion": 1,
  "purpose": "Architecture-declared evidence mappings for the Engine visibility spike. These mappings do not replace the complete SOURCE-DERIVED Git inventory.",
  "components": [
    {
      "id": "workflowPort",
      "fqn": "dvt.engine.workflowPort",
      "title": "IWorkflowEngine",
      "paths": ["src/ports/IWorkflowEngine.ts"],
      "rationale": "The public workflow behavior port is defined by this source file."
    },
    {
      "id": "workflowFacade",
      "fqn": "dvt.engine.workflowFacade",
      "title": "WorkflowEngine facade",
      "paths": ["src/core/WorkflowEngine.ts"],
      "rationale": "WorkflowEngine implements IWorkflowEngine and delegates to explicit application use cases."
    },
    {
      "id": "useCases",
      "fqn": "dvt.engine.useCases",
      "title": "Workflow engine use cases",
      "prefixes": ["src/application/workflow-engine-use-cases"],
      "rationale": "The dedicated application directory is the physical source boundary for the five workflow-engine use cases and their builder/types."
    },
    {
      "id": "startRun",
      "fqn": "dvt.engine.useCases.startRun",
      "title": "Start run",
      "paths": ["src/application/workflow-engine-use-cases/WorkflowStartRunUseCase.ts"]
    },
    {
      "id": "recoverRun",
      "fqn": "dvt.engine.useCases.recoverRun",
      "title": "Recover run",
      "paths": ["src/application/workflow-engine-use-cases/WorkflowRecoverRunUseCase.ts"]
    },
    {
      "id": "cancelRun",
      "fqn": "dvt.engine.useCases.cancelRun",
      "title": "Cancel run",
      "paths": ["src/application/workflow-engine-use-cases/WorkflowCancelRunUseCase.ts"]
    },
    {
      "id": "status",
      "fqn": "dvt.engine.useCases.status",
      "title": "Canonical status",
      "paths": ["src/application/workflow-engine-use-cases/WorkflowRunStatusUseCase.ts"]
    },
    {
      "id": "signal",
      "fqn": "dvt.engine.useCases.signal",
      "title": "Signal run",
      "paths": ["src/application/workflow-engine-use-cases/WorkflowSignalRunUseCase.ts"]
    },
    {
      "id": "startPipeline",
      "fqn": "dvt.engine.startPipeline",
      "title": "StartRun application pipeline",
      "paths": [
        "src/application/IStartRunApplicationService.ts",
        "src/application/StartRunAdmissionGuard.ts",
        "src/application/StartRunApplicationService.ts"
      ],
      "prefixes": ["src/services/startRun"],
      "rationale": "StartRunApplicationService explicitly sequences admission, intent creation, dispatch, telemetry and failure policy; the startRun service folder contains those phase implementations."
    },
    {
      "id": "coordinator",
      "fqn": "dvt.engine.startPipeline.coordinator",
      "title": "StartRun coordinator",
      "paths": ["src/application/StartRunApplicationService.ts"],
      "rationale": "StartRunApplicationService is the application-layer coordinator that sequences the StartRun phases."
    },
    {
      "id": "admission",
      "fqn": "dvt.engine.startPipeline.admission",
      "title": "Admission & integrity",
      "paths": [
        "src/application/StartRunAdmissionGuard.ts",
        "src/services/startRun/RunExecutionContextAdmissionPolicy.ts",
        "src/services/startRun/StartRunAdmissionService.ts",
        "src/services/startRun/StartRunValidationPolicy.ts",
        "src/ports/IPlanIntegrityValidator.ts"
      ]
    },
    {
      "id": "intent",
      "fqn": "dvt.engine.startPipeline.intent",
      "title": "Pre-dispatch intent",
      "paths": [
        "src/services/startRun/StartRunIntentService.ts",
        "src/ports/IStartRunIntentStore.ts"
      ]
    },
    {
      "id": "execution",
      "fqn": "dvt.engine.startPipeline.execution",
      "title": "Execution dispatch",
      "paths": [
        "src/services/startRun/StartRunExecutionService.ts",
        "src/services/startRun/StartRunEventFactory.ts"
      ]
    },
    {
      "id": "failure",
      "fqn": "dvt.engine.startPipeline.failure",
      "title": "Failure policy",
      "paths": ["src/services/startRun/StartRunFailurePolicy.ts"]
    },
    {
      "id": "providerPort",
      "fqn": "dvt.engine.providerPort",
      "title": "IProviderAdapter",
      "paths": ["src/adapters/IProviderAdapter.ts"]
    },
    {
      "id": "statePort",
      "fqn": "dvt.engine.statePort",
      "title": "IRunStateStore",
      "paths": ["src/ports/IRunStateStore.ts"]
    },
    {
      "id": "planIntegrityPort",
      "fqn": "dvt.engine.planIntegrityPort",
      "title": "IPlanIntegrityValidator",
      "paths": ["src/ports/IPlanIntegrityValidator.ts"]
    }
  ]
