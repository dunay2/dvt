{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@dvt/canonical": ["packages/@dvt/canonical/src/index.ts"],
      "@dvt/canonical/*": ["packages/@dvt/canonical/src/*"],
      "@dvt/dsl": ["packages/@dvt/dsl/src/index.ts"],
      "@dvt/dsl/*": ["packages/@dvt/dsl/src/*"],
      "@dvt/engine": ["packages/@dvt/engine/src/index.ts"],
      "@dvt/engine/*": ["packages/@dvt/engine/src/*"],
      "@dvt/plan-interpreter": ["packages/@dvt/plan-interpreter/src/index.ts"],
      "@dvt/plan-interpreter/*": ["packages/@dvt/plan-interpreter/src/*"],
      "@dvt/contracts": ["packages/@dvt/contracts/index.ts"],
      "@dvt/contracts/*": ["packages/@dvt/contracts/src/*"],
      "@dvt/adapter-postgres": ["packages/@dvt/adapter-postgres/src/index.ts"],
      "@dvt/adapter-postgres/*": ["packages/@dvt/adapter-postgres/src/*"],
      "@dvt/adapter-temporal": ["packages/@dvt/adapter-temporal/src/index.ts"],
      "@dvt/adapter-temporal/*": ["packages/@dvt/adapter-temporal/src/*"],
      "@dvt/observability": ["packages/@dvt/observability/src/index.ts"],
      "@dvt/observability/*": ["packages/@dvt/observability/src/*"],
      "@dvt/observability-otel": [
        "packages/@dvt/observability-otel/src/index.ts"
      ],
      "@dvt/observability-otel/*": ["packages/@dvt/observability-otel/src/*"]
    }
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/index.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "packages/frontend/**"
  ]
}
