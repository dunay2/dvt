{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@dvt/canonical": ["packages/@dvt/canonical/src/index.ts"],
      "@dvt/canonical/*": ["packages/@dvt/canonical/src/*"],
      "@dvt/contracts": ["packages/@dvt/contracts/index.ts"],
      "@dvt/contracts/*": ["packages/@dvt/contracts/src/*"],
      "@dvt/engine-contracts": ["packages/@dvt/engine-contracts/index.ts"],
      "@dvt/engine-contracts/*": ["packages/@dvt/engine-contracts/src/*"],
      "@dvt/state-contracts": ["packages/@dvt/state-contracts/index.ts"],
      "@dvt/state-contracts/*": ["packages/@dvt/state-contracts/src/*"],
      "@dvt/planner-contracts": ["packages/@dvt/planner-contracts/index.ts"],
      "@dvt/planner-contracts/*": ["packages/@dvt/planner-contracts/src/*"],
      "@dvt/dsl": ["packages/@dvt/dsl/src/index.ts"],
      "@dvt/dsl/*": ["packages/@dvt/dsl/src/*"],
      "@dvt/engine": ["packages/@dvt/engine/src/index.ts"],
      "@dvt/engine/*": ["packages/@dvt/engine/src/*"],
      "@dvt/plan-interpreter": ["packages/@dvt/plan-interpreter/src/index.ts"],
      "@dvt/plan-interpreter/*": ["packages/@dvt/plan-interpreter/src/*"],
      "@dvt/state-store": ["packages/@dvt/state-store/src/index.ts"],
      "@dvt/state-store/*": ["packages/@dvt/state-store/src/*"],
      "@dvt/adapter-postgres/*": ["packages/@dvt/adapter-postgres/src/*"],
      "@dvt/adapter-temporal/*": ["packages/@dvt/adapter-temporal/src/*"],
      "@dvt/cli/*": ["packages/@dvt/cli/src/*"]
    }
  },
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "dist", "test"]
}
