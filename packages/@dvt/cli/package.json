{
  "name": "@dvt/cli",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": false,
  "license": "MIT",
  "dependencies": {
    "@dvt/contracts": "workspace:*",
    "@dvt/crypto": "workspace:*",
    "@dvt/engine": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -C ../../.. exec vitest run packages/@dvt/cli/test/smoke.test.ts",
    "validate-contracts": "node validate-contracts.cjs",
    "run-golden-paths": "node run-golden-paths.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
