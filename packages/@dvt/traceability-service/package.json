{
  "name": "@dvt/traceability-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dvt-trace": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "pnpm -C ../../.. --filter @dvt/contracts build",
    "pretypecheck": "pnpm -C ../../.. --filter @dvt/contracts build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:lineage:golden": "vitest run --config vitest.config.ts test/lineage/StepStartedLineageMapper.golden.test.ts",
    "test:lineage:schema": "vitest run --config vitest.config.ts test/lineage/facetSchema.validation.test.ts",
    "trace": "node dist/cli.js"
  },
  "dependencies": {
    "@dvt/contracts": "workspace:*",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0"
  }
}
