{
  "name": "@dvt/traceability-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dvt-trace": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "node ../../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm -C ../../.. --filter \"@dvt/traceability-service^...\" build",
    "pretypecheck": "pnpm -C ../../.. --filter @dvt/contracts build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:lineage:golden": "vitest run --config vitest.config.ts test/lineage/StepStartedLineageMapper.golden.test.ts",
    "test:lineage:schema": "vitest run --config vitest.config.ts test/lineage/facetSchema.validation.test.ts",
    "trace": "node dist/cli.js"
  },
  "dependencies": {
    "@dvt/artifacts": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
