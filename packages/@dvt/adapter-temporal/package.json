{
  "name": "@dvt/adapter-temporal",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "1.15.0",
    "@temporalio/client": "1.15.0",
    "@temporalio/worker": "1.15.0",
    "@temporalio/workflow": "1.15.0",
    "@dvt/contracts": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/dsl": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/plan-interpreter": "workspace:*"
  },
  "scripts": {
    "build:runtime-deps": "node ../../../scripts/build-workspace-runtime-deps.cjs @dvt/adapter-temporal",
    "build:runtime-deps:postgres": "node ../../../scripts/build-workspace-runtime-deps.cjs @dvt/adapter-temporal --include-package @dvt/adapter-postgres",
    "build": "tsc -p tsconfig.json",
    "prebuild": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm run build:runtime-deps",
    "postbuild": "echo '✅ Build complete'",
    "pretest": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm run build:runtime-deps",
    "test": "vitest run ./test/ --exclude ./test/integration.time-skipping.test.ts --exclude ./test/integration.postgres.time-skipping.test.ts",
    "prepare:integration": "node ../../../scripts/build-workspace-runtime-deps.cjs @dvt/adapter-temporal --build-self",
    "prepare:integration:postgres": "node ../../../scripts/build-workspace-runtime-deps.cjs @dvt/adapter-temporal --include-package @dvt/adapter-postgres --build-self",
    "test:integration": "vitest run ./test/integration.time-skipping.test.ts",
    "test:integration:postgres": "vitest run ./test/integration.postgres.time-skipping.test.ts",
    "test:integration:local": "pnpm run prepare:integration && pnpm run test:integration",
    "test:integration:postgres:local": "pnpm run prepare:integration:postgres && pnpm run test:integration:postgres",
    "test:integration:watch": "vitest watch ./test/integration.time-skipping.test.ts",
    "ci:test:integration": "pnpm run prepare:integration && pnpm run test:integration",
    "ci:test:integration:postgres": "pnpm run prepare:integration:postgres && pnpm run test:integration:postgres"
  },
  "devDependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@temporalio/testing": "1.15.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
