{
  "name": "@dvt/adapter-temporal",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "1.15.0",
    "@temporalio/client": "1.15.0",
    "@temporalio/worker": "1.15.0",
    "@temporalio/workflow": "1.15.0",
    "@dvt/contracts": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/dsl": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/plan-interpreter": "workspace:*"
  },
  "scripts": {
    "build:runtime-deps": "pnpm --filter @dvt/contracts build && pnpm --filter @dvt/observability build && pnpm --filter @dvt/dsl build && pnpm --filter @dvt/plan-interpreter build && pnpm --filter @dvt/engine build",
    "build": "tsc -p tsconfig.json",
    "prebuild": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm run build:runtime-deps",
    "postbuild": "echo '✅ Build complete'",
    "pretest": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm run build:runtime-deps",
    "test": "vitest run ./test/ --exclude ./test/integration.time-skipping.test.ts",
    "pretest:integration": "pnpm run build:runtime-deps && pnpm build",
    "pretest:integration:postgres": "pnpm --filter @dvt/adapter-postgres build && pnpm run build:runtime-deps && pnpm build",
    "test:integration": "vitest run ./test/",
    "test:integration:postgres": "vitest run ./test/ --testNamePattern=\"golden path: postgres relational capability executes through the Temporal runtime\"",
    "test:integration:watch": "vitest watch ./test/",
    "ci:test:integration": "pnpm pretest:integration && pnpm test:integration",
    "ci:test:integration:postgres": "pnpm pretest:integration:postgres && pnpm test:integration:postgres"
  },
  "devDependencies": {
    "@dvt/adapter-postgres": "workspace:*",
    "@temporalio/testing": "1.15.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
