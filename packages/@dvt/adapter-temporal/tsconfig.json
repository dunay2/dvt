{
  "extends": "../../../tsconfig.package-bundler.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@dvt/artifacts": ["../../../packages/@dvt/artifacts/dist/index.d.ts"],
      "@dvt/artifacts/*": ["../../../packages/@dvt/artifacts/dist/*"],
      "@dvt/contracts": ["../../../packages/@dvt/contracts/dist/index.d.ts"],
      "@dvt/contracts/*": ["../../../packages/@dvt/contracts/dist/*"],
      "@dvt/crypto": ["../../../packages/@dvt/crypto/dist/index.d.ts"],
      "@dvt/crypto/*": ["../../../packages/@dvt/crypto/dist/*"],
      "@dvt/delivery": ["../../../packages/@dvt/delivery/dist/index.d.ts"],
      "@dvt/delivery/*": ["../../../packages/@dvt/delivery/dist/*"],
      "@dvt/engine": ["../../../packages/@dvt/engine/dist/index.d.ts"],
      "@dvt/engine/*": ["../../../packages/@dvt/engine/dist/*"],
      "@dvt/dsl": ["../../../packages/@dvt/dsl/dist/index.d.ts"],
      "@dvt/dsl/*": ["../../../packages/@dvt/dsl/dist/*"],
      "@dvt/observability": [
        "../../../packages/@dvt/observability/dist/index.d.ts"
      ],
      "@dvt/observability/*": ["../../../packages/@dvt/observability/dist/*"],
      "@dvt/plan-interpreter": [
        "../../../packages/@dvt/plan-interpreter/dist/index.d.ts"
      ],
      "@dvt/plan-interpreter/*": [
        "../../../packages/@dvt/plan-interpreter/dist/*"
      ]
    },
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
