{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvt:contracts:planner:PlannerInputEnvelopeV1:v1.0.0",
  "type": "object",
  "required": ["selection"],
  "oneOf": [
    { "required": ["graphSource"] },
    { "required": ["manifest"] },
    { "required": ["manifestRef"] },
    { "required": ["nodes"] }
  ],
  "additionalProperties": false,
  "properties": {
    "graphSource": {
      "type": "object",
      "required": ["kind", "nodes"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "normalized-graph-v1" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId", "resourceType", "dependsOn"],
            "additionalProperties": false,
            "properties": {
              "nodeId": { "type": "string" },
              "resourceType": { "type": "string" },
              "dependsOn": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "manifest": { "type": "object", "additionalProperties": true },
    "manifestRef": {
      "type": "object",
      "required": ["uri", "sha256"],
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifactId": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "resourceType", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "nodeId": { "type": "string" },
          "resourceType": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["selectedNodeIds"],
      "additionalProperties": false,
      "properties": {
        "selectedNodeIds": { "type": "array", "items": { "type": "string" } },
        "includeUpstream": { "type": "boolean" },
        "includeDownstream": { "type": "boolean" }
      }
    },
    "policies": {
      "$ref": "#/$defs/PlannerPolicyClassSet"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environmentId": { "type": "string" },
        "targetProfile": { "type": "string" },
        "vars": { "type": "object", "additionalProperties": true }
      }
    },
    "observability": { "type": "object", "additionalProperties": true },
    "requestedBy": { "type": "string" },
    "requestId": { "type": "string" },
    "requestedAtIso": { "type": "string" }
  },
  "$defs": {
    "PlannerPolicyClassSet": {
      "$id": "dvt:contracts:planner:PlannerPolicyClassSet:v2.3.1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "at-most-once" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxAttempts"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "at-most-N" },
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20
                }
              }
            }
          ]
        },
        "timeout": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "unbounded" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxSeconds"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "budget" },
                "maxSeconds": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "concurrency": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "sequential" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxParallel"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "bounded" },
                "maxParallel": { "type": "integer", "minimum": 2 }
              }
            },
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "unbounded" }
              }
            }
          ]
        }
      }
    }
  }
}
