{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvt:contracts:planner:PlannerInputEnvelopeV1:v1.0.0",
  "type": "object",
  "required": ["graphSource", "selection"],
  "additionalProperties": false,
  "properties": {
    "graphSource": {
      "type": "object",
      "required": ["kind", "sourceFamily", "sourceVersion", "nodes"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "generic-graph-v1" },
        "sourceFamily": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["nodeId", "stepKind", "dependsOn"],
            "additionalProperties": false,
            "properties": {
              "nodeId": { "type": "string" },
              "stepKind": { "type": "string" },
              "dependsOn": { "type": "array", "items": { "type": "string" } },
              "stepTypeConfig": {
                "type": "object",
                "additionalProperties": true
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "displayName": { "type": "string" },
                  "sourceRef": { "type": "string" },
                  "tags": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["selectedNodeIds"],
      "additionalProperties": false,
      "properties": {
        "selectedNodeIds": { "type": "array", "items": { "type": "string" } },
        "includeUpstream": { "type": "boolean" },
        "includeDownstream": { "type": "boolean" }
      }
    },
    "policies": {
      "$ref": "#/$defs/PlannerPolicyClassSet"
    },
    "observability": { "type": "object", "additionalProperties": true },
    "requestedBy": { "type": "string" },
    "requestId": { "type": "string" },
    "requestedAtIso": { "type": "string" }
  },
  "$defs": {
    "PlannerPolicyClassSet": {
      "$id": "dvt:contracts:planner:PlannerPolicyClassSet:v2.3.1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "at-most-once" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxAttempts"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "at-most-N" },
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 20
                }
              }
            }
          ]
        },
        "timeout": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "unbounded" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxSeconds"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "budget" },
                "maxSeconds": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "concurrency": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "sequential" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "maxParallel"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "bounded" },
                "maxParallel": { "type": "integer", "minimum": 2 }
              }
            },
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "unbounded" }
              }
            }
          ]
        }
      }
    }
  }
}
