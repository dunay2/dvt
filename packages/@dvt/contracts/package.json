{
  "name": "@dvt/contracts",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./python-code": {
      "types": "./dist/python-code.d.ts",
      "import": "./dist/python-code.js",
      "default": "./dist/python-code.js"
    }
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "schema:verify": "vitest run --passWithNoTests test/schema-sync.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
