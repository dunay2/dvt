{
  "name": "@dvt/contracts",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./substrait": {
      "types": "./dist/substrait.d.ts",
      "import": "./dist/substrait.js",
      "default": "./dist/substrait.js"
    }
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "node ../../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"@dvt/contracts^...\" build",
    "build": "tsc -b tsconfig.json",
    "pretypecheck": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/contracts^...\" build",
    "typecheck": "tsc -b tsconfig.json --noEmit",
    "pretest": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/contracts^...\" build",
    "test": "vitest run --passWithNoTests",
    "schema:verify": "vitest run --passWithNoTests test/schema-sync.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@dvt/crypto": "workspace:*",
    "zod": "^4.3.6"
  }
}
