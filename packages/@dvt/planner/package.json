{
  "name": "@dvt/planner",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts/planner/*": {
      "types": "./dist/contracts/planner/*.d.ts",
      "import": "./dist/contracts/planner/*.js",
      "default": "./dist/contracts/planner/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "pretest": "node ../../../scripts/skip-pretest-if-ci.cjs || (pnpm --filter @dvt/contracts build && pnpm --filter @dvt/artifacts build)",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../../scripts/skip-pretest-if-ci.cjs || (pnpm --filter @dvt/contracts build && pnpm --filter @dvt/artifacts build)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cross-runtime": "bash test/cross-runtime.sh",
    "test:slow": "vitest run -c vitest.config.ts --dir test/slow"
  },
  "dependencies": {
    "@dvt/artifacts": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/crypto": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
