{
  "extends": "../../../tsconfig.package-bundler.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@dvt/contracts": ["../../../packages/@dvt/contracts/dist/index.d.ts"],
      "@dvt/contracts/*": ["../../../packages/@dvt/contracts/dist/*"]
    },
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "test", "examples", "docs"]
}
