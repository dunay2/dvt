{
  "name": "@dvt/engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"@dvt/engine^...\" build",
    "pretest": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/engine^...\" build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/engine^...\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dvt/artifacts": "workspace:*",
    "@dvt/observability": "workspace:*",
    "@dvt/crypto": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "@dvt/run-domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
