{
  "name": "@dvt/adapter-postgres",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@dvt/artifacts": "workspace:*",
    "@dvt/contracts": "workspace:*",
    "@dvt/crypto": "workspace:*",
    "@dvt/delivery": "workspace:*",
    "@dvt/engine": "workspace:*",
    "@dvt/planner": "workspace:*",
    "@dvt/run-domain": "workspace:*",
    "@dvt/state-store": "workspace:*",
    "@dvt/traceability-service": "workspace:*",
    "pg": "^8.16.3"
  },
  "scripts": {
    "prebuild": "node ../../../scripts/skip-prebuild-if-orchestrated.cjs || pnpm --filter \"@dvt/adapter-postgres^...\" build",
    "pretypecheck": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/adapter-postgres^...\" build",
    "pretest": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter \"@dvt/adapter-postgres^...\" build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "test:integration": "vitest run --passWithNoTests --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
