{
  "extends": "../../../tsconfig.package-bundler.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@dvt/artifacts": ["../../../packages/@dvt/artifacts/dist/index.d.ts"],
      "@dvt/artifacts/*": ["../../../packages/@dvt/artifacts/dist/*"],
      "@dvt/contracts": ["../../../packages/@dvt/contracts/dist/index.d.ts"],
      "@dvt/contracts/*": ["../../../packages/@dvt/contracts/dist/*"],
      "@dvt/run-domain": ["../../../packages/@dvt/run-domain/dist/index.d.ts"],
      "@dvt/run-domain/*": ["../../../packages/@dvt/run-domain/dist/*"],
      "@dvt/engine": ["../../../packages/@dvt/engine/dist/index.d.ts"],
      "@dvt/engine/*": ["../../../packages/@dvt/engine/dist/*"],
      "@dvt/delivery": ["../../../packages/@dvt/delivery/dist/index.d.ts"],
      "@dvt/delivery/*": ["../../../packages/@dvt/delivery/dist/*"],
      "@dvt/planner": ["../../../packages/@dvt/planner/dist/index.d.ts"],
      "@dvt/planner/*": ["../../../packages/@dvt/planner/dist/*"],
      "@dvt/state-store": [
        "../../../packages/@dvt/state-store/dist/index.d.ts"
      ],
      "@dvt/state-store/*": ["../../../packages/@dvt/state-store/dist/*"],
      "@dvt/traceability-service": [
        "../../../packages/@dvt/traceability-service/dist/index.d.ts"
      ],
      "@dvt/traceability-service/*": [
        "../../../packages/@dvt/traceability-service/dist/*"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
