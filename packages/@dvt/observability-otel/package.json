{
  "name": "@dvt/observability-otel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../../scripts/skip-pretest-if-ci.cjs || pnpm --filter @dvt/observability build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -C ../../.. --filter @dvt/observability build && pnpm -C ../../.. exec vitest run packages/@dvt/observability-otel/test/OtelObservability.test.ts"
  },
  "dependencies": {
    "@dvt/observability": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
