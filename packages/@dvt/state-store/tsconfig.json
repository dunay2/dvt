{
  "extends": "../../../tsconfig.package-bundler.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@dvt/crypto": ["packages/@dvt/canonical/dist/index.d.ts"],
      "@dvt/crypto/*": ["packages/@dvt/canonical/dist/*"],
      "@dvt/contracts": ["packages/@dvt/contracts/dist/index.d.ts"],
      "@dvt/contracts/*": ["packages/@dvt/contracts/dist/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
