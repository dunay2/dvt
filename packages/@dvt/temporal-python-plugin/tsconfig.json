{
  "extends": "../../../tsconfig.package-bundler.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@dvt/adapter-temporal": [
        "../../../packages/@dvt/adapter-temporal/dist/index.d.ts"
      ],
      "@dvt/contracts": ["../../../packages/@dvt/contracts/dist/index.d.ts"],
      "@dvt/contracts/python-code": [
        "../../../packages/@dvt/contracts/dist/python-code.d.ts"
      ]
    },
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
