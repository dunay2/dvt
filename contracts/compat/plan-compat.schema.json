{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanCompatMatrix",
  "description": "Adapter compatibility matrix for ExecutionPlan schema versions (ADR-0017).",
  "type": "object",
  "required": ["schema", "versions"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["ExecutionPlan"],
      "description": "The contract name this matrix covers."
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "adapters"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+$",
            "description": "Schema version in vMAJOR.MINOR format."
          },
          "adapters": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Map of adapter name to support flag (true = supported, false = not supported)."
          }
        }
      }
    }
  }
}
